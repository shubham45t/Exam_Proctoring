# Copy to backend/.env and adjust. All values are optional in development. No real secrets belong in this file.
OMNI_ENV=development                 # set to "production" to disable synthetic events
# OMNI_DATABASE_URL=sqlite:///./data/omniproctor.db      # PostgreSQL support is planned (Phase 8), not yet tested
# OMNI_MEDIA_DIR=./data/media        # prerecorded test videos (VIDEO_FILE sources) must live directly here
# OMNI_CORS_ORIGINS=["http://127.0.0.1:5173"]
# Camera health thresholds (calibrate on authorised footage; see docs/camera-health.md)
# OMNI_STALE_AFTER_S=5
# OMNI_FROZEN_AFTER_S=8
# OMNI_DARK_LUMA_THRESHOLD=25
# OMNI_BLUR_LAPLACIAN_THRESHOLD=20
# OMNI_ANALYSIS_FPS=4

# Object detection (download the model first: python scripts/download_model.py)
# OMNI_DETECTOR=yolox_onnx            # "none" turns object detection off
# OMNI_DETECTOR_CLASSES=["cell phone"]
# OMNI_DETECT_FPS=2
# OMNI_TRACK_HIGH_CONF=0.45
# OMNI_EVIDENCE_RETENTION_DAYS=30     # set the period your institution approves
